    { "id": 104, "type": "row", "title": "HTTP by path", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }, "panels": [] },
    {
      "id": 20,
      "type": "table",
      "title": "Requests, latency and errors by path",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false, "filterable": false }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "req/s" }, "properties": [{ "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 3 }] },
          { "matcher": { "id": "byName", "options": "p95 (s)" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }] },
          { "matcher": { "id": "byName", "options": "error share" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 2 }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "req/s", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(sum by (job, http_route) (rate(http_server_request_duration_seconds_count{job=~\"shizu-api|shizustore-web\",http_route!=\"\"}[$__rate_interval])), \"service_path\", \" \", \"job\", \"http_route\")",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "B",
          "expr": "label_join(histogram_quantile(0.95, sum by (le, job, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"shizu-api|shizustore-web\",http_route!=\"\"}[$__rate_interval]))), \"service_path\", \" \", \"job\", \"http_route\")",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "refId": "C",
          "expr": "label_join((sum by (job, http_route) (rate(http_server_request_duration_seconds_count{job=~\"shizu-api|shizustore-web\",http_route!=\"\",http_response_status_code=~\"[45]..\"}[$__rate_interval])) or (0 * sum by (job, http_route) (rate(http_server_request_duration_seconds_count{job=~\"shizu-api|shizustore-web\",http_route!=\"\"}[$__rate_interval])))) / sum by (job, http_route) (rate(http_server_request_duration_seconds_count{job=~\"shizu-api|shizustore-web\",http_route!=\"\"}[$__rate_interval])), \"service_path\", \" \", \"job\", \"http_route\")",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "service_path", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "http_route": true },
            "renameByName": { "Value": "req/s", "Value #A": "req/s", "Value #B": "p95 (s)", "Value #C": "error share" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "req/s", "desc": true }] } }
      ]
    },
    { "id": 105, "type": "row", "title": "App popularity", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 }, "panels": [] },
    {
      "id": 25,
      "type": "table",
      "title": "Top apps by views (24h)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false, "filterable": false }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "views (24h)" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "views (24h)", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(topk(20, sum by (job, slug) (increase(shizu_app_views_total{slug!=\"\"}[24h]))), \"source\", \"client\", \"job\", \"shizu-api\"), \"source\", \"webstore\", \"job\", \"shizustore-web\")",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true },
            "renameByName": { "Value": "views (24h)", "Value #A": "views (24h)", "source": "source", "slug": "app" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "views (24h)", "desc": true }] } }
      ]
    },
