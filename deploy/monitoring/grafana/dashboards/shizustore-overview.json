        { "refId": "C", "expr": "sum by (job) (kestrel_queued_connections{job=~\"shizu-api|shizustore-web\"})", "legendFormat": "{{job}} queued", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
