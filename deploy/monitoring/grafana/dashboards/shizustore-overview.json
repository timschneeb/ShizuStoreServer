      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"shizu-api|shizustore-web\",http_response_status_code=~\"[45]..\"}[1h])) / sum(rate(http_server_request_duration_seconds_count{job=~\"shizu-api|shizustore-web\"}[1h]))",
          "legendFormat": "errors",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
