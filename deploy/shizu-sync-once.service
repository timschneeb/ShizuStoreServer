[Unit]
# Manual one-shot pass over the list: first production backfill, or a forced
# full resync. Do not start while shizuappstore.service is active, otherwise
# two enrich passes race on the same rows.
Description=Shizu App Store one-shot sync (manual backfill)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# A full backfill downloads and enriches hundreds of APKs and can run for
# hours; never let systemd time it out.
TimeoutStartSec=infinity
User=shizu
Group=shizu
WorkingDirectory=/opt/shizuappstore/app
ExecStart=/opt/shizuappstore/app/ShizuAppStoreServer --sync-once --full
EnvironmentFile=/etc/shizuappstore/env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=GRADLE_USER_HOME=/opt/shizuappstore/gradle-home
Environment=ANDROID_HOME=/opt/android-sdk
# APK downloads and staged render dirs must not land in the tmpfs /tmp: on a
# 4GB box a single 400MB APK there is charged to this cgroup, pushes it over
# MemoryHigh and stalls the API in reclaim. Keep the temp dir on disk.
Environment=TMPDIR=/opt/shizuappstore/tmp
# Same resource caps as the long-running service: the backfill must not
# starve the rest of the box.
MemoryHigh=1500M
MemoryMax=1800M
MemorySwapMax=256M
CPUQuota=150%
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
IOWeight=50
LogsDirectory=shizu
# Hardening (same set as shizuappstore.service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shizuappstore/icons /opt/shizuappstore/icon-render /opt/shizuappstore/gradle-home /opt/shizuappstore/list /opt/shizuappstore/tmp
