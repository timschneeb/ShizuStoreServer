[Unit]
Description=Shizu App Store API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=shizu
Group=shizu
WorkingDirectory=/opt/shizuappstore/app
ExecStart=/opt/shizuappstore/app/ShizuAppStoreServer
EnvironmentFile=/etc/shizuappstore/env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5137
# Paparazzi renders through the Gradle tool in /opt/shizuappstore/icon-render.
# Gradle needs a writable home for its daemon registry and caches, and the
# Android SDK location for AGP.
Environment=GRADLE_USER_HOME=/opt/shizuappstore/gradle-home
Environment=ANDROID_HOME=/opt/android-sdk
# APK downloads and staged render dirs must not land in the tmpfs /tmp: on a
# 4GB box a single 400MB APK there is charged to this cgroup, pushes it over
# MemoryHigh and stalls the API in reclaim. Keep the temp dir on disk.
Environment=TMPDIR=/opt/shizuappstore/tmp
# Icon renders move into a transient systemd user scope so their JVMs are not
# charged to this unit's cgroup; systemd-run --user reaches the service user's
# manager through this runtime dir (needs linger, see the setup doc). The
# numeric UID is the service user's: %U expands to the system manager's UID.
Environment=XDG_RUNTIME_DIR=/run/user/958
# Always: a clean exit must not leave the API down. Manual stops are respected.
Restart=always
RestartSec=10
# The worker enriches APKs in parallel; hard-cap CPU/memory/IO so a full
# backfill cannot starve the rest of the box. Icon render JVMs live outside
# this cgroup in a bounded user scope (Enrichment:IconRenderScope) and are
# additionally heap-capped in gradle-home/gradle.properties and
# tools/icon-render/app/build.gradle.
MemoryHigh=1500M
MemoryMax=1800M
MemorySwapMax=256M
CPUQuota=150%
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
IOWeight=50
# systemd creates /var/log/shizu (Enrichment:RunLogPath) with the right owner
# and implies write access under ProtectSystem=strict. Usage-analysis logs
# live under /opt/shizuappstore/usage-logs and need the ReadWritePaths entry
# below instead.
LogsDirectory=shizu
# Hardening (the service only needs loopback HTTP + Postgres + outbound HTTPS
# for the GitHub/GitLab/F-Droid APIs, plus write access to the icon store, the
# Gradle tool/daemon state, and the list clone it git-fetches).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=yes masks /run/user, hiding the service user's systemd manager
# bus: the render scope (systemd-run --user) could not connect and every icon
# would silently fall back to a letter avatar.
ProtectHome=read-only
ReadWritePaths=/opt/shizuappstore/icons /opt/shizuappstore/icon-render /opt/shizuappstore/gradle-home /opt/shizuappstore/list /opt/shizuappstore/tmp /opt/shizuappstore/usage-logs

[Install]
WantedBy=multi-user.target
