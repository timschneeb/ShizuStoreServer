{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Overridden by appsettings.Production.json on the server and by the
    // SHIZU_CONNECTION_STRING environment variable ( __ → : mapping).
    "Shizu": "Host=localhost;Database=shizuappstore;Username=shizu"
  },
  "Enrichment": {
    // Production overrides live in appsettings.Production.json on the server
    // (see docs/server-setup.md). The GitHub PAT comes from SHIZU_GITHUB_TOKEN,
    // the GitLab token from SHIZU_GITLAB_TOKEN.
    "Aapt2Path": "aapt2",
    // apksigner (build-tools, needs a JRE) for signing-cert fingerprints;
    // required at startup like aapt2 (per-APK failures still leave sig_*
    // null instead of failing enrichment).
    "ApksignerPath": "apksigner",
    // gradle + the Paparazzi tool below render XML/adaptive launcher icons
    // through LayoutLib; required at startup like aapt2.
    "GradlePath": "gradle",
    "IconToolDir": "tools/icon-render",
    "IconStorePath": "icons",
    // Optional taskset CPU list for the render JVM (for example "0" pins it
    // to one core); null renders on every core.
    // "IconRenderCpuAffinity": "0",
    // Optional append-only log with one line per scanned app per sync pass,
    // followed by the same health snapshot as GET /v1/issues. Null disables it.
    // "RunLogPath": "/var/log/shizu/enrichment-runs.log",
    // Metadata-only passes: refresh release feeds, changelogs, screenshots and
    // stars without downloading or analyzing APKs (recorded downloads and
    // icons stay). Meant for one-off runs (`--sync-once --full --skip-apk` or
    // Enrichment__SkipApkAnalysis=true), not persisted here.
    // "SkipApkAnalysis": true,
    "MaxParallelism": 4
  },
  "Api": {
    // Fixed-window rate limit, requests/minute/client IP.
    "RateLimitPerMinute": 100,
    // Server-side output caching for GET /v1/* (tests turn this off).
    "EnableOutputCache": true
  },
  "UserAgentTracking": {
    // Anonymous client usage stats (SPEC 3): one aggregate row per distinct
    // User-Agent plus one row per UA per UTC day. DB-only, no endpoint.
    // /healthz, /icons/*, /v1/admin/* and UA-less requests are not tracked.
    "Enabled": true,
    // How often buffered hits are written to the database.
    "FlushInterval": "00:00:10",
    // Bounded in-memory buffer; overflow is dropped and logged.
    "MaxBufferedHits": 2000
  },
  "RequestLog": {
    // Suspicious-traffic log (SPEC 3): every request whose User-Agent is not a
    // ShizuStore/<major>.<minor>.<patch> client, on every endpoint including
    // /icons, /healthz, /v1/admin and 404s. Headers and the raw request line
    // are stored verbatim, so admin tokens land here too; rows are kept
    // forever. DB-only, no endpoint.
    "Enabled": true,
    // How often buffered entries are written to the database.
    "FlushInterval": "00:00:10",
    // Bounded in-memory buffer; overflow is dropped and logged.
    "MaxBufferedHits": 2000
  },
  "Sync": {
    // Local awesome-shizuku clone (production: /opt/shizuappstore/list via
    // appsettings.Production.json; local runs: point at your checkout).
    "ListPath": "/opt/shizuappstore/list",
    // Fast-loop period in minutes
    "FastLoopMinutes": 15,
    // Nightly full re-check time, HH:mm UTC.
    "NightlyTimeUtc": "03:00",
    // Run one pass at startup (first boot = initial backfill).
    "RunOnStartup": true,
    // Fast-path release poll (SPEC 7.2): off without SHIZU_GITHUB_TOKEN.
    "PollEnabled": true,
    // Concurrent release-metadata fetches in the poll.
    "PollParallelism": 8
  }
  // Admin webhook HMAC secret: set via the SHIZU_ADMIN_SECRET environment
  // variable (or appsettings.Production.json on the server), never here.
}
