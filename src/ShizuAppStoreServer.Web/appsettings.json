{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Read-only credentials for the API's Postgres database. The production
  // password lives in appsettings.Production.json on the host, never here.
  "ConnectionStrings": {
    "Shizu": "Host=localhost;Database=shizuappstore;Username=shizu"
  },
  // Icon store written by the API workers; the storefront only reads it so
  // icon responses do not depend on the API being up.
  "Icons": {
    "StorePath": "/opt/shizuappstore/icons"
  },
  // Prometheus scraping endpoint (GET /metrics) with the storefront's built-in
  // ASP.NET Core, Kestrel, HTTP client, EF Core and Npgsql meters. Bearer-token
  // protected; set Metrics:Token (production: appsettings.Production.json) or
  // SHIZU_METRICS_TOKEN. Without a token the endpoint is not mapped;
  // "Enabled": false turns collection off entirely.
  "Metrics": {
    "Enabled": true
  },
  // Fingerprints published for Android App Link verification. Debug builds
  // are not listed on purpose: links are claimed by the release signing key.
  "AssetLinks": {
    "PackageName": "me.timschneeberger.shizustore",
    "Fingerprints": [
      "E7:62:FF:C1:5D:2F:8D:E8:AB:19:1D:F5:3E:A5:A5:25:F9:0D:3F:F3:79:56:FC:D4:E3:04:E0:34:0B:AF:BA:BA"
    ]
  }
}
